{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Focus 个人任务管理器",
  "version": "0.3.8",
  "identifier": "com.focusai.taskmanager",
  "build": {
    "beforeDevCommand": "pnpm dev --port 3000",
    "beforeBuildCommand": "pnpm generate:desktop",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Focus 个人任务管理器",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "backgroundColor": "#17191d",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/focus/32x32.png",
      "icons/focus/128x128.png",
      "icons/focus/128x128@2x.png",
      "icons/focus/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1ODk4MDZENUVBREU4OTAKUldTUTZLMWViWUNKVmZQOFFaL3AvTDMvRGJDMTYveThNQUFtYlNJYS9CaDBZWHdUR2J4elRvZSsK",
      "endpoints": [
        "https://github.com/Alon9527/personal-ai-task-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
